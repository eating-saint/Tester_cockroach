# 浏览器专用用户目录（含 cookie 和缓存，体积大）
profiles/
# 每次运行的产物（截图、PageState、报告）
runs/
# 人眼比对的采集截图、作答与报告（比对集定义 compare/sets/ 入库）
compare/*/
!compare/sets/
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
# 面板：打包产物、单实例锁、设置写回前的备份
build_out/
build/
dist/
panel.lock
config.yaml.bak
# 编辑器/助手的本机配置（settings.local.json 含本机权限），只留面板启动配置
.claude/*
!.claude/launch.json
# 本地工作记录（会话整理稿、交接笔记），不入库
docs/**/*_sessions/
docs/**/handover*.md
